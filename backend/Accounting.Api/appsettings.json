{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seeding": {
    "Mode": "Raw"
  },
  "SessionSettings": {
    "AbsoluteTimeoutSeconds": 86400,
    "IdleTimeoutSeconds": 3600
  },
  "JwtSettings": {
    "Issuer": "AccountingApi",
    "Audience": "AccountingClient",
    "AccessTokenExpirationSeconds": 900,
    "RefreshTokenExpirationSeconds": 604800
  }
}
